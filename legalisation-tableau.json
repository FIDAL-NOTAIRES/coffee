{
 "source": "Ministère de l'Europe et des Affaires étrangères — Tableau récapitulatif de l'état actuel du droit conventionnel en matière de légalisation",
 "miseAJour": "11/09/2026",
 "lien": "https://www.diplomatie.gouv.fr/files/files/services/demarches-a-letranger/leg-tableau-recap-du-droit-conventionnel-11-09-26.pdf",
 "types": {
  "I": "Actes de l'état civil (naissance, mariage, décès, reconnaissance)",
  "II": "Actes judiciaires ou extrajudiciaires (Kbis, jugements…)",
  "III": "Affidavits, déclarations écrites, documents enregistrés ou déposés aux tribunaux judiciaires",
  "IV": "Actes notariés (copies d'actes en minute ou en brevet, actes authentiques)",
  "V": "Actes administratifs (diplômes, casiers judiciaires, certificats de nationalité…)",
  "VI": "Certificats de vie des rentiers viagers",
  "VII": "Certificats de l'Institut national de la propriété industrielle",
  "VIII": "Documents établis ou certifiés par les agents diplomatiques ou consulaires",
  "IX": "Actes sous seing privé portant une mention officielle (certification matérielle de signature)"
 },
 "dispenses": {
  "a": "convention bilatérale",
  "b": "convention de la Commission internationale de l'état civil du 26 septembre 1957",
  "c": "convention de la Commission internationale de l'état civil du 15 septembre 1977",
  "d": "convention du Conseil de l'Europe du 7 juin 1968 (actes des agents diplomatiques ou consulaires)",
  "e": "convention des Communautés européennes du 25 mai 1987",
  "f": "convention de la Commission internationale de l'état civil du 8 septembre 1976 (extraits plurilingues ; apostille pour les actes uniquement en français)",
  "g": "règlement (UE) 2016/1191 du 6 juillet 2016",
  "h": "convention de Lugano (décisions en matière civile et commerciale rendues depuis le 1er janvier 2011, avec le certificat de l'annexe V ; apostille pour les autres documents)"
 },
 "renvois": {
  "1": {
   "defaut": "A",
   "texte": "Légalisation pour les documents établis par une administration ayant trait directement à une opération commerciale ou douanière (certificat sanitaire, attestation de libre vente, certificat de non-radioactivité…) ; apostille pour les autres documents."
  },
  "2": {
   "defaut": "A",
   "texte": "Légalisation pour les documents administratifs liés à une opération commerciale ou douanière ; dispense (règlement UE 2016/1191) pour les actes publics relatifs à la naissance, au fait d'être en vie, au décès, au nom, au mariage, au divorce, au partenariat enregistré, à la filiation, à l'adoption, au domicile ou à la résidence, à la nationalité, à l'absence de casier judiciaire et aux élections européennes ou municipales ; apostille pour les autres documents."
  },
  "3": {
   "defaut": "A",
   "texte": "Comme le renvoi (2), avec en outre une dispense (convention bilatérale) pour les documents ayant trait à la protection des mineurs ; apostille pour les autres documents."
  },
  "5": {
   "defaut": "A",
   "texte": "Dispense pour les actes relatifs à l'état civil, à la capacité ou à la situation familiale, à la nationalité, au domicile et à la résidence, et pour tous actes produits en vue d'un mariage ou de l'établissement d'un acte d'état civil (convention CIEC 1977) ; apostille pour les autres documents."
  },
  "6": {
   "defaut": "",
   "texte": "Dispense ou apostille/légalisation selon la nature propre de l'acte : se reporter à la catégorie correspondante dans les autres colonnes du tableau."
  },
  "7": {
   "defaut": "A",
   "texte": "Dispense (règlement UE 2016/1191) pour les actes publics relatifs à l'état civil, au domicile, à la nationalité, à l'absence de casier judiciaire et aux élections ; dispense (convention bilatérale) pour les actes publics et sous seing privé certifiés produits dans une procédure judiciaire civile ou commerciale, hors faillite, concordat et règlement judiciaire ; apostille pour les autres documents."
  },
  "8": {
   "defaut": "A",
   "texte": "Dispense (règlement UE 2016/1191) pour les actes publics relatifs à l'état civil, au domicile, à la nationalité, à l'absence de casier judiciaire et aux élections ; dispense (convention bilatérale) pour les documents ayant trait à la protection des mineurs ; apostille pour les autres documents."
  },
  "9": {
   "defaut": "A",
   "texte": "Légalisation pour les documents administratifs liés à une opération commerciale ou douanière ; dispense (convention CIEC 1977) pour les actes relatifs à l'état civil, à la situation familiale, à la nationalité, au domicile, et pour les actes produits en vue d'un mariage ; apostille pour les autres documents."
  },
  "10": {
   "defaut": "A",
   "texte": "Dispense (règlement UE 2016/1191) pour les actes publics relatifs à la naissance, au fait d'être en vie, au décès, au nom, au mariage, au divorce, au partenariat enregistré, à la filiation, à l'adoption, au domicile ou à la résidence, à la nationalité, à l'absence de casier judiciaire et aux élections ; apostille pour les autres documents."
  },
  "11": {
   "defaut": "A",
   "texte": "Dispense (convention bilatérale) pour les actes judiciaires ou extrajudiciaires produits dans le cadre d'une procédure d'entraide judiciaire ; apostille pour les autres documents."
  }
